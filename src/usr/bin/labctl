#!/bin/bash

# Set from the RPM Version: at build time (the spec's %install replaces the
# placeholder). A checkout keeps it, and labctl then reports a development copy.
LABCTL_VERSION="@VERSION@"
LAB_ROOT="/opt/linux-labs/labs"
LIB_DIR="/opt/linux-labs/lib"
STATE_FILE="/opt/linux-labs/.current_lab"
# "<lab> <target>": where labctl started the active lab (see active_lab)
TARGET_FILE="/opt/linux-labs/.current_target"
PROFILE_SCRIPT="/etc/profile.d/labctl.sh"
# labctl's own SSH known_hosts for server targets (not root's)
KNOWN_HOSTS="/var/lib/linux-labs/known_hosts"
# The invoking user's home. Under sudo this is SUDO_USER's home, not /root,
# so "sudo labctl start" reads the same config that "labctl configure" saved.
_lab_user_home="${HOME:-/root}"
if [[ "${EUID:-$(id -u)}" -eq 0 && -n "${SUDO_USER:-}" && "$SUDO_USER" != root ]]; then
    _lab_user_home="$(getent passwd "$SUDO_USER" | cut -d: -f6)"
    _lab_user_home="${_lab_user_home:-${HOME:-/root}}"
fi
CONFIG_DIR="${XDG_CONFIG_HOME:-$_lab_user_home/.config}/linux-labs"
CONFIG_FILE="$CONFIG_DIR/config"
SYSTEM_CONFIG="/etc/linux-labs/config"

# Use system config if available, otherwise user config
if [[ -f "$SYSTEM_CONFIG" ]]; then
    CONFIG_FILE="$SYSTEM_CONFIG"
fi

# Stop early when the config file cannot be written (for example the system
# config under /etc without sudo), instead of reporting a change that failed
require_writable_config() {
  local dir
  dir="$(dirname "$CONFIG_FILE")"
  if { [[ -e "$CONFIG_FILE" ]] && [[ ! -w "$CONFIG_FILE" ]]; } \
     || { [[ ! -e "$CONFIG_FILE" ]] && [[ -d "$dir" ]] && [[ ! -w "$dir" ]]; }; then
    echo "Error: cannot write $CONFIG_FILE. Use: sudo labctl configure ..." >&2
    exit 1
  fi
}

# A config written under sudo belongs to the user who ran sudo, not root
fix_config_owner() {
  if [[ "$CONFIG_FILE" != "$SYSTEM_CONFIG" && "$EUID" -eq 0 && -n "${SUDO_USER:-}" && "$SUDO_USER" != root ]]; then
    chown -R "$SUDO_USER": "$CONFIG_DIR" 2>/dev/null || true
  fi
}

usage() {
  echo "Usage: labctl {start|task|grade|reset|list|hint|solution|configure} <lab>"
  echo "       labctl {check|--version|help}"
  echo ""
  echo "Commands:"
  echo "  start <lab>              - Start a lab and show its task (requires root)"
  echo "  task <lab>               - Show the task of a lab again"
  echo "  grade <lab>              - Grade a lab"
  echo "  reset <lab>              - Reset a lab (requires root)"
  echo "  list [--course <c>] [--level <l>]"
  echo "                           - List labs, optionally filtered by course"
  echo "                             and level (beginner, intermediate, advanced)"
  echo "  check                    - Check that the lab environment is ready"
  echo "                             (configuration, SSH key, servers)"
  echo "  help                     - Show this help"
  echo "  --version                - Show the installed linux-labs version"
  echo "  hint <lab> [--all]       - Show the next hint (--all: every hint)"
  echo "  solution <lab> [--yes]   - Show lab solution (asks first on a"
  echo "                             terminal; --yes skips the question)"
  echo "  configure <action>       - Configure lab environment"
  echo ""
  echo "Configuration actions:"
  echo "  configure interactive    - Interactive configuration wizard"
  echo "  configure list           - Show current configuration"
  echo "  configure set KEY VALUE  - Set configuration value"
  echo "  configure validate       - Validate configuration"
  echo "  configure reset          - Reset to defaults"
  echo ""
  echo "Documentation: man labctl, /usr/share/doc/linux-labs/"
  echo "Online: https://matej-basic.github.io/linux-labs/"
  exit "${1:-1}"
}

# True when <lab> is an installed lab (one of its scripts is executable)
is_known_lab() {
  case "$1" in ""|*/*) return 1 ;; esac
  [ -x "$LAB_ROOT/$1"/setup.sh ] || [ -x "$LAB_ROOT/$1"/grade.sh ] || [ -x "$LAB_ROOT/$1"/cleanup.sh ]
}

# Require a lab name for commands that need one
require_lab() {
  local lab="$1"
  if [ -z "$lab" ]; then
    usage
  fi
  if ! is_known_lab "$lab"; then
    echo "Unknown lab: $lab" >&2
    exit 1
  fi
}

# --- The active lab ---------------------------------------------------------
#
# One lab is active at a time. $STATE_FILE holds its name (the [LAB:...]
# prompt reads it) and $TARGET_FILE holds "<lab> <target>", the machine
# labctl ran setup.sh on. labctl 1.1.0 wrote only $STATE_FILE and ran
# every lab on the workstation, so an active lab without a matching
# $TARGET_FILE line was started by an older labctl, on this workstation.

# Print the name of the active lab, nothing when no lab is active
active_lab() {
  [ -r "$STATE_FILE" ] || return 0
  head -n 1 "$STATE_FILE" 2>/dev/null
}

# True when <lab> is the active lab and an older labctl started it
started_by_old_labctl() {
  local rec
  [ -n "$1" ] && [ "$(active_lab)" = "$1" ] || return 1
  rec=$(head -n 1 "$TARGET_FILE" 2>/dev/null)
  [ "${rec%% *}" != "$1" ]
}

old_start_error() {
  echo "Error: lab $1 was started with an older version of linux-labs." >&2
  echo "Reset it, then start it again: sudo labctl reset $1" >&2
}

# write_markers <lab> <target>: record the active lab after its setup
write_markers() {
  mkdir -p "$(dirname "$STATE_FILE")"
  echo "$1" > "$STATE_FILE"
  printf '%s %s\n' "$1" "$2" > "$TARGET_FILE"
  chmod 0644 "$STATE_FILE" "$TARGET_FILE" 2>/dev/null
}

# clear_markers <lab>: forget the active lab after a reset of <lab>. The
# reset of another lab leaves the record of the active lab alone.
clear_markers() {
  local active
  active=$(active_lab)
  if [ -z "$active" ] || [ "$active" = "$1" ]; then
    rm -f "$STATE_FILE" "$TARGET_FILE"
  fi
}

# Extract a one-line description for a lab from description.txt
lab_description() {
  local lab="$1"
  local desc_file="$LAB_ROOT/$lab/description.txt"
  local desc=""

  if [ -f "$desc_file" ]; then
    # Grep the objective line and extract text after "objective: "
    desc=$(grep "^objective:" "$desc_file" | sed 's/^objective:[[:space:]]*//')
  fi

  [ -z "$desc" ] && desc="No description available"
  echo "$desc"
}

# Print the value of one "key: value" line from a lab's description.txt
lab_field() {
  local lab="$1" key="$2"
  local desc_file="$LAB_ROOT/$lab/description.txt"
  [ -f "$desc_file" ] || return 0
  sed -n "s/^${key}:[[:space:]]*//p" "$desc_file" | head -n 1
}

# Turn the needs: value ("internet, reboot, free-nic, nodes=3") into text
needs_text() {
  local item out=""
  for item in $(printf '%s\n' "$1" | tr -d ','); do
    case "$item" in
      free-nic) item="free network interface" ;;
      nodes=*) item="${item#nodes=} nodes" ;;
    esac
    out="${out:+$out, }$item"
  done
  printf '%s\n' "$out"
}

# Print task.txt with the known placeholders filled in. Runs in a subshell
# so that load-config.sh (needed only for node placeholders) does not leak
# variables or functions into labctl.
#
# Placeholders: {{EL_MAJOR}} {{ARCH}} {{HOSTNAME}} {{LAB_USER}}
#               {{NODE_COUNT}} {{NODE1_IP}} .. {{NODE9_IP}}
render_task() (
  local lab="$1"
  local file="$LAB_ROOT/$lab/task.txt"
  local text el_major arch host lab_user n ip unknown target

  text=$(cat "$file")

  # EL_MAJOR and ARCH come from the workstation even for a server target:
  # the classroom servers run the same release, and the task needs no SSH.
  # shellcheck source=/dev/null
  el_major=$(. /etc/os-release 2>/dev/null && echo "${VERSION_ID%%.*}")
  arch=$(uname -m)
  target=$(lab_target "$lab")
  if is_server_target "$target"; then
    host="$target"
  else
    host=$(uname -n)
  fi
  lab_user=$(task_user "$lab")

  text=${text//"{{EL_MAJOR}}"/"$el_major"}
  text=${text//"{{ARCH}}"/"$arch"}
  text=${text//"{{HOSTNAME}}"/"$host"}
  text=${text//"{{LAB_USER}}"/"$lab_user"}

  case "$text" in
    *"{{NODE"*)
      # shellcheck source=/dev/null
      source /opt/linux-labs/lib/load-config.sh >/dev/null 2>&1
      text=${text//"{{NODE_COUNT}}"/"${NODE_COUNT:-0}"}
      for n in 1 2 3 4 5 6 7 8 9; do
        ip=""
        if [ "$n" -le "${NODE_COUNT:-0}" ]; then
          ip=$(get_node_ip "$n" 2>/dev/null)
        fi
        [ -z "$ip" ] && ip="(node $n not configured)"
        text=${text//"{{NODE${n}_IP}}"/"$ip"}
      done
      ;;
  esac

  unknown=$(printf '%s\n' "$text" | grep -o '{{[A-Za-z0-9_]*}}' | sort -u | tr '\n' ' ')
  if [ -n "$unknown" ]; then
    echo "labctl: warning: unknown placeholders in $file: $unknown" >&2
  fi

  printf '%s\n' "$text"
)

# --- Lab targets ------------------------------------------------------------
#
# description.txt "target:" names the machine a single-node lab runs on:
# workstation (the machine labctl runs on) or servera, serverb, serverc.
# A server is a node of the configuration: servera is node 1 (the first
# NODE_IPS entry, or <network base>.10), serverb node 2, serverc node 3,
# so classroom DNS names are not required. Multi-node labs have no target
# and run their scripts on the workstation, like workstation labs.

# Print the target of a lab; no target: line means workstation
lab_target() {
  local t
  t=$(lab_field "$1" target)
  printf '%s\n' "${t:-workstation}"
}

# Print the node number of a server target, fail for anything else
target_node() {
  case "$1" in
    servera) echo 1 ;;
    serverb) echo 2 ;;
    serverc) echo 3 ;;
    *) return 1 ;;
  esac
}

is_server_target() {
  target_node "$1" >/dev/null
}

# Print the address, SSH user, key and port for a server target, one per
# line. Runs in a subshell so load-config.sh leaks nothing into labctl.
# HOME is the invoking user's home, so the default key and "$HOME" in the
# config file mean the key of the sudo caller (student), not root's.
target_settings() (
  HOME="$_lab_user_home"
  # shellcheck source=/dev/null
  source "$LIB_DIR/load-config.sh" >/dev/null 2>&1 || exit 1
  printf '%s\n' "$(get_node_ip "$(target_node "$1")")" "$SSH_USER" "$SSH_KEY_PATH" "$SSH_PORT"
)

# Set T_NAME, T_IP, T_USER, T_KEY and T_PORT for a server target
load_target() {
  local out
  T_NAME="$1"
  if ! out=$(target_settings "$1"); then
    echo "Error: cannot read the lab configuration ($LIB_DIR/load-config.sh)." >&2
    return 1
  fi
  { read -r T_IP; read -r T_USER; read -r T_KEY; read -r T_PORT; } <<< "$out"
  if [ -z "$T_IP" ]; then
    echo "Error: no address for $T_NAME (node $(target_node "$T_NAME")). Set NODE_IPS: labctl configure set NODE_IPS \"<servera> <serverb> <serverc>\"" >&2
    return 1
  fi
  return 0
}

# The user who does the task (exported to the lab scripts as LAB_USER and
# shown as {{LAB_USER}}): SSH_USER on a server target; on the workstation
# the sudo caller, else the current non-root user, else student
task_user() {
  local target
  target=$(lab_target "$1")
  if is_server_target "$target"; then
    target_settings "$target" | sed -n 2p
  else
    local_task_user
  fi
}

# The task user of a lab that runs on the workstation
local_task_user() {
  if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
    printf '%s\n' "$SUDO_USER"
  elif [ "$EUID" -ne 0 ]; then
    id -un
  else
    echo student
  fi
}

# Print "Work on servera: ssh opsadmin@servera" for a server target. The
# target name is used when it resolves to the configured address from
# here, else the address itself. Needs no SSH.
connect_line() {
  local target out ip user port host port_opt=""
  target=$(lab_target "$1")
  is_server_target "$target" || return 0
  out=$(target_settings "$target") || return 0
  { read -r ip; read -r user; read -r _; read -r port; } <<< "$out"
  [ -n "$ip" ] || return 0
  host="$ip"
  if getent ahosts "$target" 2>/dev/null | awk '{ print $1 }' | grep -qxF "$ip"; then
    host="$target"
  fi
  [ "${port:-22}" = 22 ] || port_opt="-p $port "
  printf 'Work on %s: ssh %s%s@%s\n' "$target" "$port_opt" "$user" "$host"
}

# ssh to the loaded target as SSH_USER with the configured key. BatchMode:
# never a password prompt; host keys go to labctl's own known_hosts.
target_ssh() {
  mkdir -p "${KNOWN_HOSTS%/*}" 2>/dev/null
  ssh -o BatchMode=yes -o ConnectTimeout=10 \
    -o ServerAliveInterval=15 -o ServerAliveCountMax=4 \
    -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$KNOWN_HOSTS" \
    -o IdentitiesOnly=yes -o LogLevel=ERROR \
    -i "$T_KEY" -p "$T_PORT" "$T_USER@$T_IP" "$@"
}

# bundle_file <file> <path in the bundle>: one file of the target bundle
bundle_file() {
  # shellcheck disable=SC2016 # $d is expanded on the target
  printf 'base64 -d > "$d/%s" <<'"'"'LABCTL_EOF'"'"'\n' "$2"
  base64 < "$1"
  printf 'LABCTL_EOF\n'
}

# Print a bash script that recreates the lab directory (without solve.sh
# and known-issues.md), the library and the prompt script in a temporary
# directory on the target, runs lib/target-run.sh there and removes the
# directory. It needs only bash and base64 on the target. The whole script
# is one brace group, so bash reads all of it before anything runs and no
# command can read the rest of the script from stdin.
target_bundle() {
  local lab="$1" mode="$2" colour="$3" f name
  # shellcheck disable=SC2016 # $d is expanded on the target
  printf '%s\n' '{' 'set -u' 'd=$(mktemp -d /tmp/labctl.XXXXXX) || exit 1' \
    "mkdir -p \"\$d/labs/$lab\" \"\$d/lib\""
  for f in "$LAB_ROOT/$lab"/*; do
    [ -f "$f" ] || continue
    name="${f##*/}"
    case "$name" in
      solve.sh|known-issues.md) continue ;;
    esac
    bundle_file "$f" "labs/$lab/$name"
  done
  for f in "$LIB_DIR"/*.sh; do
    [ -f "$f" ] && bundle_file "$f" "lib/${f##*/}"
  done
  [ -f "$PROFILE_SCRIPT" ] && bundle_file "$PROFILE_SCRIPT" profile.sh
  # shellcheck disable=SC2016 # expanded on the target
  printf 'bash "$d/lib/target-run.sh" "$d" %q %q %q %q\n' "$mode" "$lab" "$T_USER" "$colour"
  # shellcheck disable=SC2016 # expanded on the target
  printf '%s\n' 'rc=$?' 'rm -rf "$d"' 'exit "$rc"' '} </dev/null'
}

# run_on_target <lab> <start|grade|reset>
# Run the lab script on the loaded target as root. Output streams through,
# and the exit status is that of the lab script.
run_on_target() {
  local lab="$1" mode="$2" colour=0 rc
  if [ ! -r "$T_KEY" ]; then
    echo "Error: cannot read the SSH key $T_KEY for $T_USER@$T_NAME. Set SSH_KEY_PATH: labctl configure set SSH_KEY_PATH <file>" >&2
    return 1
  fi
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    colour=1
  fi
  target_bundle "$lab" "$mode" "$colour" | target_ssh "sudo -n bash -s"
  rc=${PIPESTATUS[1]}
  if [ "$rc" -eq 255 ]; then
    echo "Error: cannot connect to $T_NAME ($T_IP) over SSH as $T_USER." >&2
  fi
  return "$rc"
}

# Hints: the "## Hints" section of solution.md
#
# Format (checked by scripts/check-labs.sh):
#   ## Hints
#
#   1. First hint, may wrap onto
#      indented continuation lines.
#   2. Second hint.
#
# A lab with several independent parts may group its hints. A line in
# column 0 that starts with "Task N:" opens a group, and the numbering
# restarts at 1 in each group. labctl numbers hints 1..M across groups
# and prints the group line before the first hint of the group.
# Blank lines are ignored. The section ends at the next "## " heading.
hints_section() {
  awk '/^## /{insec=($0=="## Hints");next} insec{print}' \
    "$LAB_ROOT/$1/solution.md"
}

lab_has_hints() {
  [ -f "$LAB_ROOT/$1/solution.md" ] && grep -qx '## Hints' "$LAB_ROOT/$1/solution.md"
}

# Number of hints in the section
hint_count() {
  hints_section "$1" | grep -cE '^[0-9]+\. '
}

# Print the first $2 hints with their group lines
print_hints() {
  hints_section "$1" | awk -v shown="$2" '
    /^$/ { next }
    /^Task [0-9]+:/ { group = $0; newgroup = 1; next }
    /^[0-9]+\. / {
      idx++
      if (idx > shown) { on = 0; next }
      on = 1
      if (newgroup) { if (idx > 1) print ""; print group; newgroup = 0 }
      sub(/^[0-9]+\. /, "")
      print idx ". " $0
      next
    }
    on { print }
  '
}

# The invoking user's hint counter (SUDO_USER's home under sudo)
hint_counter_file() {
  printf '%s\n' "$_lab_user_home/.local/state/linux-labs/hints/$1"
}

# Write the counter. Directories created here under sudo go to the user.
write_hint_counter() {
  local file="$1" value="$2" dir top
  dir="$(dirname "$file")"
  top="$dir"
  while [ ! -e "$(dirname "$top")" ]; do top="$(dirname "$top")"; done
  mkdir -p "$dir" || return 1
  printf '%s\n' "$value" > "$file"
  if [ "$EUID" -eq 0 ] && [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
    [ -e "$top" ] && [ ! "$top" = "$dir" ] && chown -R "$SUDO_USER": "$top" 2>/dev/null
    chown "$SUDO_USER": "$dir" "$file" 2>/dev/null
  fi
  return 0
}

# Remove the invoking user's hint counter of a lab
clear_hint_counter() {
  rm -f "$(hint_counter_file "$1")"
}

show_hint() {
  local lab="$1" all="$2" total given shown file
  if ! lab_has_hints "$lab" || [ "$(hint_count "$lab")" -eq 0 ]; then
    echo "This lab has no hints. Use labctl solution $lab to see the full solution."
    return 0
  fi
  total=$(hint_count "$lab")
  if [ "$all" = yes ]; then
    printf '%s: all %s hints\n\n' "$lab" "$total"
    print_hints "$lab" "$total"
    return 0
  fi
  file=$(hint_counter_file "$lab")
  given=0
  [ -f "$file" ] && given=$(head -n 1 "$file")
  case "$given" in ''|*[!0-9]*) given=0 ;; esac
  shown=$((given + 1))
  [ "$shown" -le "$total" ] || shown=$total
  write_hint_counter "$file" "$shown" || echo "labctl: warning: cannot save the hint counter" >&2
  printf '%s: hint %s of %s\n\n' "$lab" "$shown" "$total"
  print_hints "$lab" "$shown"
  echo ""
  if [ "$shown" -lt "$total" ]; then
    echo "Run labctl hint $lab again for the next hint."
  else
    echo "That was the last hint. labctl solution $lab shows the full solution."
  fi
}

# Print the task header and the task text of a converted lab
print_task() {
  local lab="$1"
  local title category level needs
  title=$(lab_field "$lab" title)
  category=$(lab_field "$lab" category)
  level=$(lab_field "$lab" complexity)
  needs=$(lab_field "$lab" needs)

  if [ -n "$title" ]; then
    printf '%s: %s\n' "$lab" "$title"
  else
    printf '%s\n' "$lab"
  fi
  printf 'Category: %s    Level: %s\n' "${category:-unknown}" "${level:-unknown}"
  if [ -n "$needs" ]; then
    printf 'Needs: %s\n' "$(needs_text "$needs")"
  fi
  connect_line "$lab"
  printf '%s\n\n' "========================================================================"
  render_task "$lab"
  if lab_has_hints "$lab"; then
    printf '\nStuck? Run labctl hint %s\n' "$lab"
  fi
}

# Setup default configuration
setup_default_config() {
  require_writable_config
  [[ "$CONFIG_FILE" == "$SYSTEM_CONFIG" ]] || mkdir -p "$CONFIG_DIR"
  cat > "$CONFIG_FILE" << 'EOF'
# Linux Labs Configuration
LAB_NETWORK="172.25.250.0/24"
LAB_GATEWAY="172.25.250.254"
LAB_DNS="8.8.8.8"
NODES_ENABLED=false
NODE_COUNT=1
NODE_IPS=""
SSH_KEY_PATH="$HOME/.ssh/id_rsa"
SSH_USER="opsadmin"
SSH_PORT="22"
DOCKER_ENABLED=false
EOF
  fix_config_owner
  echo "Created default config at $CONFIG_FILE"
}

# Load configuration
load_config() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    setup_default_config
  fi
  source "$CONFIG_FILE" 2>/dev/null || true
}

# Interactive configuration wizard
configure_interactive() {
  echo "======================================"
  echo "Linux Labs Configuration Wizard"
  echo "======================================"
  echo ""
  
  load_config
  
  echo "Current settings:"
  echo "  Lab Network: $LAB_NETWORK"
  echo "  Gateway: $LAB_GATEWAY"
  echo "  DNS: $LAB_DNS"
  echo "  Multi-node: $NODES_ENABLED"
  echo "  Node IPs: ${NODE_IPS:-auto-calculated}"
  echo ""
  
  read -p "Enable multi-node labs? (y/n) [n]: " nodes_enabled
  if [[ "$nodes_enabled" == "y" || "$nodes_enabled" == "Y" ]]; then
    NODES_ENABLED=true
    read -p "Number of nodes? [3]: " node_count
    NODE_COUNT="${node_count:-3}"
    
    echo ""
    echo "Node IP Configuration:"
    echo "  1. Auto-calculate from network (e.g., 172.25.250.10, .11, .12)"
    echo "  2. Set static IP addresses"
    read -p "Choose option [1]: " ip_option
    
    if [[ "$ip_option" == "2" ]]; then
      echo ""
      echo "Enter static IP addresses (space-separated):"
      read -p "IPs: " static_ips
      NODE_IPS="$static_ips"
      # Update NODE_COUNT based on number of IPs provided
      NODE_COUNT=$(echo "$NODE_IPS" | wc -w)
      echo "Using $NODE_COUNT static IPs: $NODE_IPS"
    else
      NODE_IPS=""
      echo "IPs will be auto-calculated from $LAB_NETWORK"
    fi
  else
    NODES_ENABLED=false
    NODE_COUNT=1
    NODE_IPS=""
  fi
  
  read -p "Lab network [${LAB_NETWORK:-172.25.250.0/24}]: " lab_network
  LAB_NETWORK="${lab_network:-${LAB_NETWORK:-172.25.250.0/24}}"
  
  read -p "Gateway IP [${LAB_GATEWAY:-172.25.250.254}]: " lab_gateway
  LAB_GATEWAY="${lab_gateway:-${LAB_GATEWAY:-172.25.250.254}}"
  
  read -p "DNS server [${LAB_DNS}]: " lab_dns
  LAB_DNS="${lab_dns:-$LAB_DNS}"
  
  # Save configuration
  require_writable_config
  [[ "$CONFIG_FILE" == "$SYSTEM_CONFIG" ]] || mkdir -p "$CONFIG_DIR"
  cat > "$CONFIG_FILE" << EOF
# Linux Labs Configuration
LAB_NETWORK="$LAB_NETWORK"
LAB_GATEWAY="$LAB_GATEWAY"
LAB_DNS="$LAB_DNS"
NODES_ENABLED=$NODES_ENABLED
NODE_COUNT=$NODE_COUNT
NODE_IPS="$NODE_IPS"
SSH_KEY_PATH="\$HOME/.ssh/id_rsa"
SSH_USER="opsadmin"
SSH_PORT="22"
DOCKER_ENABLED=false
EOF
  
  echo ""
  fix_config_owner
  echo "Configuration saved to $CONFIG_FILE"
}

# List current configuration
configure_list() {
  load_config
  echo "Current Lab Configuration:"
  echo "=========================="
  echo "Network: $LAB_NETWORK"
  echo "Gateway: $LAB_GATEWAY"
  echo "DNS: $LAB_DNS"
  echo "Multi-node enabled: $NODES_ENABLED"
  echo "Node count: $NODE_COUNT"
  if [[ -n "$NODE_IPS" ]]; then
    echo "Node IPs (static): $NODE_IPS"
  else
    echo "Node IPs: auto-calculated from network"
  fi
  echo "SSH Key: $SSH_KEY_PATH"
  echo "SSH User: $SSH_USER"
  echo "SSH Port: $SSH_PORT"
  echo "Config file: $CONFIG_FILE"
  echo ""
}

# Set specific configuration value
configure_set() {
  local key="$1"
  local value="$2"
  
  if [[ -z "$key" || -z "$value" ]]; then
    echo "Usage: labctl configure set KEY VALUE"
    exit 1
  fi
  
  load_config
  require_writable_config
  [[ "$CONFIG_FILE" == "$SYSTEM_CONFIG" ]] || mkdir -p "$CONFIG_DIR"
  
  # Update configuration file
  if grep -q "^${key}=" "$CONFIG_FILE" 2>/dev/null; then
    sed -i "s|^${key}=.*|${key}=\"${value}\"|" "$CONFIG_FILE"
  else
    echo "${key}=\"${value}\"" >> "$CONFIG_FILE"
  fi
  
  fix_config_owner
  echo "Set $key = $value"
}

# Validate configuration
configure_validate() {
  load_config
  
  echo "Validating configuration..."
  
  # Check network syntax
  if [[ ! "$LAB_NETWORK" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}/[0-9]{1,2}$ ]]; then
    echo "Error: invalid network format: $LAB_NETWORK"
    return 1
  fi
  echo "Network format valid"
  
  # Check gateway IP
  if [[ ! "$LAB_GATEWAY" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
    echo "Error: invalid gateway IP: $LAB_GATEWAY"
    return 1
  fi
  echo "Gateway IP valid"
  
  # Check DNS IP
  if [[ ! "$LAB_DNS" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
    echo "Error: invalid DNS IP: $LAB_DNS"
    return 1
  fi
  echo "DNS IP valid"
  
  echo "All validations passed"
  return 0
}

# --- labctl check -----------------------------------------------------------
#
# A read-only check of the classroom environment: the configuration, the
# SSH key, SSH and passwordless sudo on the servers, the releases, free
# NICs on servera and repository access from servera. It runs as the
# calling user and needs no root: the student's key is readable by the
# student, and the configuration is the one "sudo labctl start" reads.
# It writes nothing outside a temporary file. Host keys are checked
# against a temporary copy of labctl's known_hosts, so a known server
# with a changed key fails as it would for start, and a new server is
# accepted for this run only.

CHECK_PASSED=0
CHECK_WARNED=0
CHECK_FAILED=0

# check_line <PASS|WARN|FAIL> <text> [<how to fix>]
check_line() {
  grade_line "$2" "$1"
  case "$1" in
    PASS) CHECK_PASSED=$((CHECK_PASSED + 1)) ;;
    WARN) CHECK_WARNED=$((CHECK_WARNED + 1)) ;;
    *) CHECK_FAILED=$((CHECK_FAILED + 1)) ;;
  esac
  if [ "$1" != PASS ] && [ -n "${3:-}" ]; then
    printf '    %s\n' "$3"
  fi
}

# The settings that "sudo labctl start" sees, one per line: the config
# file, its state (ok, missing, unreadable), NODES_ENABLED, NODE_COUNT,
# SSH_USER, SSH_KEY_PATH, SSH_PORT, then the addresses of nodes 1 to 9.
# sudo resets the environment, so the environment does not count here.
check_settings() (
  HOME="$_lab_user_home"
  unset XDG_CONFIG_HOME LAB_NETWORK LAB_GATEWAY LAB_DNS NODES_ENABLED \
    NODE_COUNT NODE_IPS SSH_KEY_PATH SSH_USER SSH_PORT DOCKER_ENABLED
  # shellcheck source=/dev/null
  source "$LIB_DIR/load-config.sh" >/dev/null 2>&1 || exit 1
  state=ok
  if [ ! -e "$CONFIG_FILE" ]; then
    state=missing
  elif [ ! -r "$CONFIG_FILE" ]; then
    state=unreadable
  fi
  printf '%s\n' "$CONFIG_FILE" "$state" "$NODES_ENABLED" "$NODE_COUNT" \
    "$SSH_USER" "$SSH_KEY_PATH" "$SSH_PORT"
  for n in 1 2 3 4 5 6 7 8 9; do
    get_node_ip "$n"
  done
)

# Print "<name> <major>" of this machine's /etc/os-release
check_os_local() (
  NAME="" VERSION_ID=""
  # shellcheck source=/dev/null
  [ -r /etc/os-release ] && . /etc/os-release
  printf '%s %s\n' "${NAME:-unknown}" "${VERSION_ID:-}"
)

# The script that runs on a server as SSH_USER (no root). Argument 1:
# also look for free NICs and probe the package repositories. A free NIC
# is what the network labs use: ethernet, with a device, not the
# default-route interface, not enslaved. The repository probe connects
# to the host of the first enabled repository; any answer counts.
check_remote_script() {
  cat <<'EOF'
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:$PATH
echo LABCTL_CHECK
if sudo -n true >/dev/null 2>&1; then echo sudo=yes; else echo sudo=no; fi
( NAME="" VERSION_ID=""
  [ -r /etc/os-release ] && . /etc/os-release
  echo "os=${NAME:-unknown} ${VERSION_ID:-}" )
[ "${1:-0}" = 1 ] || exit 0
def=$(ip -o route show default 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
nics=""
for path in /sys/class/net/*; do
  dev=${path##*/}
  [ "$dev" = "$def" ] && continue
  [ "$(cat "$path/type" 2>/dev/null)" = 1 ] || continue
  [ -e "$path/device" ] || continue
  [ -e "$path/master" ] && continue
  nics="$nics $dev"
done
echo "nics=${nics# }"
url=$(awk '
  function flush() {
    if (sec && tolower(en) !~ /^(0|false|no)$/ && u != "") { print u; done = 1; exit }
  }
  /^\[/ { flush(); sec = 1; en = "1"; u = ""; next }
  /^[ \t]*enabled[ \t]*=/ { v = $0; sub(/^[^=]*=[ \t]*/, "", v); en = v; next }
  /^[ \t]*(baseurl|mirrorlist|metalink)[ \t]*=/ {
    if (u == "") { v = $0; sub(/^[^=]*=[ \t]*/, "", v); u = v }
    next
  }
  END { if (!done) flush() }
' /etc/yum.repos.d/*.repo 2>/dev/null)
url=${url%%[ ,]*}
case "$url" in
  http://*|https://*|ftp://*) ;;
  file://*) echo repo=local; exit 0 ;;
  "") echo repo=none; exit 0 ;;
  *) echo repo=unknown; exit 0 ;;
esac
host=$(printf '%s\n' "$url" | sed -E 's#^([a-z]+://[^/?]+).*#\1#')
case "$host" in *'$'*) echo repo=unknown; exit 0 ;; esac
command -v curl >/dev/null 2>&1 || { echo repo=nocurl; exit 0; }
curl -k -s -o /dev/null --max-time 6 "$host/"
rc=$?
case "$rc" in
  5|6|7|28) echo "repo=unreachable ${host#*://}" ;;
  *) echo "repo=ok ${host#*://}" ;;
esac
EOF
}

# check_server <name> <node> <ip> <user> <key> <port> <known_hosts>
#   <key ok> <workstation major> <probe>
check_server() {
  local name="$1" node="$2" ip="$3" user="$4" key="$5" port="$6" kh="$7"
  local key_ok="$8" ws_major="$9" probe="${10}" out err rc
  local sudo_ok os major nics count repo nic_list
  if [ "$key_ok" != yes ]; then
    check_line FAIL "SSH as $user to $name ($ip) works" \
      "Fix: the SSH key above must work first."
    return
  fi
  err=$(mktemp) || return
  out=$(check_remote_script | timeout 20 ssh -o BatchMode=yes \
    -o ConnectTimeout=5 -o ServerAliveInterval=5 -o ServerAliveCountMax=2 \
    -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$kh" \
    -o IdentitiesOnly=yes -o LogLevel=ERROR \
    -i "$key" -p "$port" "$user@$ip" "bash -s -- $probe" 2>"$err")
  rc=$?
  if [ "$(printf '%s\n' "$out" | head -n 1)" != LABCTL_CHECK ]; then
    if grep -q 'IDENTIFICATION HAS CHANGED' "$err"; then
      check_line FAIL "SSH as $user to $name ($ip) works" \
        "Fix: the host key changed; sudo ssh-keygen -R $ip -f $KNOWN_HOSTS"
    elif grep -q 'UNPROTECTED PRIVATE KEY' "$err"; then
      check_line FAIL "SSH as $user to $name ($ip) works" \
        "Fix: ssh refuses the key; chmod 600 $key"
    elif grep -q 'Permission denied' "$err"; then
      check_line FAIL "SSH as $user to $name ($ip) works" \
        "Fix: install the key on $name: ssh-copy-id -i $key $user@$ip"
    elif [ "$rc" -eq 124 ]; then
      check_line FAIL "SSH as $user to $name ($ip) works" \
        "Fix: $name does not answer in time; check that it is running."
    else
      check_line FAIL "SSH as $user to $name ($ip) works" \
        "Fix: start $name, or set NODE_IPS (node $node) to its address."
    fi
    rm -f "$err"
    return
  fi
  rm -f "$err"
  check_line PASS "SSH as $user to $name ($ip) works"

  sudo_ok=$(printf '%s\n' "$out" | sed -n 's/^sudo=//p')
  if [ "$sudo_ok" = yes ]; then
    check_line PASS "$user has passwordless sudo on $name"
  else
    check_line FAIL "$user has passwordless sudo on $name" \
      "Fix: on $name add: $user ALL=(ALL) NOPASSWD: ALL to sudoers"
  fi

  os=$(printf '%s\n' "$out" | sed -n 's/^os=//p')
  major="${os##* }"
  major="${major%%.*}"
  case "$major" in
    8|9)
      if [ "$major" = "$ws_major" ]; then
        check_line PASS "$name runs $os"
      else
        check_line WARN "$name runs $os" \
          "Fix: use the same major release as the workstation ($ws_major)."
      fi
      ;;
    *)
      check_line WARN "$name runs $os" \
        "Fix: the labs support Rocky Linux and RHEL 8 and 9."
      ;;
  esac

  [ "$probe" = 1 ] || return
  nics=$(printf '%s\n' "$out" | sed -n 's/^nics=//p')
  read -ra nic_list <<< "$nics"
  count=${#nic_list[@]}
  if [ "$count" -ge 2 ]; then
    check_line PASS "$name has two free NICs for the network labs"
  elif [ "$count" -eq 1 ]; then
    check_line WARN "$name has one free NIC ($nics), networking-03 needs two" \
      "Fix: add a second NIC on an isolated network to $name."
  else
    check_line WARN "$name has no free NIC for the network labs" \
      "Fix: add two NICs on an isolated network to $name."
  fi

  repo=$(printf '%s\n' "$out" | sed -n 's/^repo=//p')
  case "$repo" in
    ok*)
      check_line PASS "$name reaches its package repositories" ;;
    local)
      check_line PASS "$name uses a local package repository" ;;
    unreachable*)
      check_line WARN "$name reaches its package repositories" \
        "Fix: labs that need internet fail; check DNS and routes there." ;;
    nocurl)
      check_line WARN "$name reaches its package repositories" \
        "Fix: curl is missing on $name, so this was not tested." ;;
    *)
      check_line WARN "$name has an enabled package repository" \
        "Fix: enable the BaseOS and AppStream repositories on $name." ;;
  esac
}

# labctl check: print one line per check, exit 0 when nothing failed
run_check() {
  local out cfg cfg_state nodes_on node_count user key port ips
  local caller host ws_os ws_major servers n name ip kh key_ok rule_ok warnings

  # shellcheck source=/dev/null
  if ! source "$LIB_DIR/grading.sh" 2>/dev/null; then
    echo "Error: cannot read $LIB_DIR/grading.sh." >&2
    return 1
  fi
  if ! out=$(check_settings); then
    echo "Error: cannot read the lab configuration ($LIB_DIR/load-config.sh)." >&2
    return 1
  fi
  {
    read -r cfg; read -r cfg_state; read -r nodes_on; read -r node_count
    read -r user; read -r key; read -r port
  } <<< "$out"
  mapfile -t ips < <(printf '%s\n' "$out" | sed -n '8,16p')

  caller=$(id -un)
  if [ "$EUID" -eq 0 ] && [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
    caller="$SUDO_USER"
  fi
  host=$(uname -n)
  host="${host%%.*}"
  printf 'Checking the lab environment for %s on %s\n\n' "$caller" "$host"

  case "$cfg_state" in
    ok) check_line PASS "Configuration $cfg is readable" ;;
    missing)
      check_line WARN "No configuration file, the defaults apply" \
        "Fix: labctl configure set NODE_IPS \"<servera> <serverb> <serverc>\"" ;;
    *)
      check_line FAIL "Configuration $cfg is readable" \
        "Fix: make it readable for everyone: sudo chmod 0644 $cfg" ;;
  esac

  # servera always; serverb, serverc and further nodes with multi-node labs
  servers=1
  if [ "$nodes_on" = true ]; then
    if [[ "$node_count" =~ ^[0-9]+$ ]] && [ "$node_count" -ge 3 ]; then
      check_line PASS "Multi-node labs are enabled for $node_count nodes"
    else
      check_line WARN "Multi-node labs are enabled for $node_count nodes" \
        "Fix: the 3-node labs need: labctl configure set NODE_COUNT 3"
    fi
    if [[ "$node_count" =~ ^[0-9]+$ ]] && [ "$node_count" -gt 1 ]; then
      servers="$node_count"
      [ "$servers" -gt 9 ] && servers=9
    fi
  else
    check_line WARN "Multi-node labs are disabled" \
      "Fix: for lb, replication and clustering set NODES_ENABLED true"
  fi
  for ((n = 1; n <= servers; n++)); do
    name=$(check_node_name "$n")
    ip="${ips[$((n - 1))]:-}"
    if [ -n "$ip" ]; then
      check_line PASS "$name (node $n) has the address $ip"
    else
      check_line FAIL "$name (node $n) has an address" \
        "Fix: labctl configure set NODE_IPS \"<servera> <serverb> <serverc>\""
    fi
  done

  key_ok=no
  if [ -r "$key" ] && [ -f "$key" ]; then
    key_ok=yes
    check_line PASS "SSH key $key is readable"
  elif [ -e "$key" ]; then
    check_line FAIL "SSH key $key is readable" \
      "Fix: chmod 600 $key, owned by $caller"
  else
    check_line FAIL "SSH key $key exists" \
      "Fix: create it with ssh-keygen, or set SSH_KEY_PATH to your key."
  fi

  if [ "$EUID" -eq 0 ] && [ -z "${SUDO_USER:-}" ]; then
    check_line PASS "labctl runs as root"
  else
    rule_ok=no
    if [ "$EUID" -eq 0 ]; then
      sudo -n -l -U "$caller" /usr/bin/labctl >/dev/null 2>&1 && rule_ok=yes
    else
      sudo -n -l /usr/bin/labctl >/dev/null 2>&1 && rule_ok=yes
    fi
    if [ "$rule_ok" = yes ]; then
      check_line PASS "$caller may run labctl through sudo without a password"
    else
      check_line WARN "$caller may run labctl through sudo without a password" \
        "Fix: log in as student, or add a sudoers rule for $caller."
    fi
  fi

  ws_os=$(check_os_local)
  ws_major="${ws_os##* }"
  ws_major="${ws_major%%.*}"
  case "$ws_major" in
    8|9) check_line PASS "Workstation runs $ws_os" ;;
    *) check_line WARN "Workstation runs $ws_os" \
         "Fix: the labs support Rocky Linux and RHEL 8 and 9." ;;
  esac

  kh=$(mktemp) || return 1
  # shellcheck disable=SC2064 # expand $kh now
  trap "rm -f '$kh'" EXIT
  [ -r "$KNOWN_HOSTS" ] && cat "$KNOWN_HOSTS" > "$kh" 2>/dev/null
  for ((n = 1; n <= servers; n++)); do
    ip="${ips[$((n - 1))]:-}"
    [ -n "$ip" ] || continue
    name=$(check_node_name "$n")
    if [ "$n" -eq 1 ]; then
      check_server "$name" "$n" "$ip" "$user" "$key" "$port" "$kh" "$key_ok" "$ws_major" 1
    else
      check_server "$name" "$n" "$ip" "$user" "$key" "$port" "$kh" "$key_ok" "$ws_major" 0
    fi
  done
  rm -f "$kh"
  trap - EXIT

  printf '\n'
  if [ "$CHECK_FAILED" -eq 0 ]; then
    grade_line "Overall result" PASS
  else
    grade_line "Overall result" FAIL
  fi
  warnings=warnings
  [ "$CHECK_WARNED" -eq 1 ] && warnings=warning
  printf '%s passed, %s %s, %s failed.\n' \
    "$CHECK_PASSED" "$CHECK_WARNED" "$warnings" "$CHECK_FAILED"
  [ "$CHECK_FAILED" -eq 0 ]
}

# servera, serverb and serverc for nodes 1 to 3, else "node<N>"
check_node_name() {
  case "$1" in
    1) echo servera ;;
    2) echo serverb ;;
    3) echo serverc ;;
    *) echo "node$1" ;;
  esac
}

case "$1" in
  start)
    require_lab "$2"
    if [ "$EUID" -ne 0 ]; then
      echo "Error: 'labctl start' requires root. Use: sudo labctl start $2" >&2
      exit 1
    fi
    # One lab at a time: another active lab is reset first, so that its
    # changes do not stay behind. Starting the active lab again is fine
    # (setup.sh is idempotent), unless an older labctl started it on this
    # workstation. A marker naming a lab that is not installed is ignored.
    active=$(active_lab)
    if is_known_lab "$active"; then
      if [ "$active" != "$2" ]; then
        echo "Error: lab $active is still active. Only one lab can be active at a time." >&2
        echo "Finish it first: sudo labctl reset $active" >&2
        exit 1
      fi
      if started_by_old_labctl "$2"; then
        old_start_error "$2"
        exit 1
      fi
    fi
    clear_hint_counter "$2"
    target=$(lab_target "$2")
    if is_server_target "$target"; then
      # Server target: setup.sh runs on the server as root over SSH. The
      # server keeps the lab copy, the lab state and its own prompt marker
      # until reset; the workstation keeps the marker for its prompt.
      load_target "$target" || exit 1
      run_on_target "$2" start
      rc=$?
      if [ "$rc" -ne 0 ]; then
        echo "Error: setup of lab $2 failed (exit $rc). The lab was not started." >&2
        exit "$rc"
      fi
      write_markers "$2" "$target"
      print_task "$2"
      exit 0
    fi
    LAB_USER=$(task_user "$2")
    export LAB_USER
    if [ -f "$LAB_ROOT/$2/task.txt" ]; then
      # Framework 2.0 lab: setup prints nothing, labctl prints the task.
      # A failed setup leaves the lab not started.
      "$LAB_ROOT/$2/setup.sh"
      rc=$?
      if [ "$rc" -ne 0 ]; then
        echo "Error: setup of lab $2 failed (exit $rc). The lab was not started." >&2
        exit "$rc"
      fi
      write_markers "$2" "$target"
      print_task "$2"
    else
      # Legacy lab: setup.sh prints its own banner
      "$LAB_ROOT/$2/setup.sh"
      write_markers "$2" "$target"
    fi
    # The [LAB:...] prompt picks up $STATE_FILE through PROMPT_COMMAND
    # (/etc/profile.d/labctl.sh) at the next prompt of the student's shell.
    exit 0
    ;;
  task)
    require_lab "$2"
    if started_by_old_labctl "$2"; then
      old_start_error "$2"
      exit 1
    fi
    if [ ! -f "$LAB_ROOT/$2/task.txt" ]; then
      echo "No task text for lab $2. Run 'sudo labctl start $2' to see its task." >&2
      exit 1
    fi
    print_task "$2"
    ;;
  grade)
    require_lab "$2"
    # An older labctl ran setup.sh on this workstation; grading here or on
    # the target would compare against a setup that does not match
    if started_by_old_labctl "$2"; then
      old_start_error "$2"
      exit 1
    fi
    if [ "$EUID" -ne 0 ]; then
      # Graders always run as root, so they can read root-only state
      # (firewalld permanent config, /var/named, logs). The sudoers rule
      # lets the student run labctl without a password.
      if sudo -n -l /usr/bin/labctl >/dev/null 2>&1; then
        exec sudo -n /usr/bin/labctl grade "$2"
      fi
      echo "Error: grading needs root. Use: sudo labctl grade $2" >&2
      exit 1
    fi
    target=$(lab_target "$2")
    if is_server_target "$target"; then
      load_target "$target" || exit 1
      run_on_target "$2" grade
      exit $?
    fi
    LAB_USER=$(task_user "$2")
    export LAB_USER
    "$LAB_ROOT/$2/grade.sh"
    ;;
  reset)
    require_lab "$2"
    if [ "$EUID" -ne 0 ]; then
      echo "Error: 'labctl reset' requires root. Use: sudo labctl reset $2" >&2
      exit 1
    fi
    target=$(lab_target "$2")
    if is_server_target "$target" && started_by_old_labctl "$2"; then
      # An older labctl ran this lab on the workstation. Clean up there
      # with the local cleanup.sh, as that version would have, and on the
      # target, which the current labctl uses. The record goes either way.
      echo "Lab $2 was started with an older version of linux-labs. Cleaning it up on this workstation and on $target."
      LAB_USER=$(local_task_user)
      export LAB_USER
      "$LAB_ROOT/$2/cleanup.sh"
      rc_local=$?
      rc_target=1
      if load_target "$target"; then
        run_on_target "$2" reset
        rc_target=$?
      fi
      clear_markers "$2"
      clear_hint_counter "$2"
      if [ "$rc_local" -ne 0 ]; then
        echo "Error: cleanup of lab $2 on this workstation failed (exit $rc_local)." >&2
      fi
      if [ "$rc_target" -ne 0 ]; then
        echo "Error: cleanup of lab $2 on $target failed (exit $rc_target)." >&2
      fi
      [ "$rc_local" -ne 0 ] && exit "$rc_local"
      exit "$rc_target"
    fi
    if is_server_target "$target"; then
      # cleanup.sh runs on the server, which then drops its lab copy and
      # its prompt marker
      load_target "$target" || exit 1
      run_on_target "$2" reset
      rc=$?
      clear_markers "$2"
      clear_hint_counter "$2"
      if [ "$rc" -ne 0 ]; then
        echo "Error: cleanup of lab $2 failed (exit $rc)." >&2
        exit "$rc"
      fi
      exit 0
    fi
    LAB_USER=$(task_user "$2")
    export LAB_USER
    "$LAB_ROOT/$2/cleanup.sh"
    rc=$?
    clear_markers "$2"
    clear_hint_counter "$2"
    if [ -f "$LAB_ROOT/$2/task.txt" ] && [ "$rc" -ne 0 ]; then
      # Framework 2.0 lab: report a failed cleanup
      echo "Error: cleanup of lab $2 failed (exit $rc)." >&2
      exit "$rc"
    fi
    exit 0
    ;;
  list)
    shift
    want_course=""
    want_level=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --course|--level)
          if [ "$#" -lt 2 ] || [ -z "$2" ]; then
            echo "Error: $1 needs a value" >&2
            exit 1
          fi
          if [ "$1" = "--course" ]; then want_course="$2"; else want_level="$2"; fi
          shift 2
          ;;
        *)
          echo "Error: unknown option for list: $1" >&2
          usage
          ;;
      esac
    done
    want_course=$(printf '%s' "$want_course" | tr '[:upper:]' '[:lower:]')
    want_level=$(printf '%s' "$want_level" | tr '[:upper:]' '[:lower:]')
    case "$want_level" in
      ""|beginner|intermediate|advanced) ;;
      *) echo "Error: --level must be beginner, intermediate or advanced" >&2; exit 1 ;;
    esac
    printf "%-16s  %s\n" "LAB" "DESCRIPTION"
    printf "%-16s  %s\n" "----------------" "----------------------------------------------"
    shown=0
    for lab in $(ls -1 "$LAB_ROOT" | sort); do
      if [ -n "$want_course" ]; then
        c=$(lab_field "$lab" course | tr '[:upper:]' '[:lower:]')
        [ "$c" = "$want_course" ] || continue
      fi
      if [ -n "$want_level" ]; then
        l=$(lab_field "$lab" complexity | tr '[:upper:]' '[:lower:]')
        [ "$l" = "$want_level" ] || continue
      fi
      desc=$(lab_description "$lab")
      printf "%-16s  %s\n" "$lab" "$desc"
      shown=$((shown + 1))
    done
    if [ "$shown" -eq 0 ]; then
      echo "No labs match."
    fi
    ;;
  hint)
    require_lab "$2"
    hint_all=no
    if [ "$#" -ge 3 ]; then
      if [ "$3" = "--all" ] && [ "$#" -eq 3 ]; then
        hint_all=yes
      else
        echo "Error: unknown option for hint: $3" >&2
        usage
      fi
    fi
    show_hint "$2" "$hint_all"
    ;;
  solution)
    require_lab "$2"
    sol_yes=no
    if [ "$#" -ge 3 ]; then
      if [ "$3" = "--yes" ] && [ "$#" -eq 3 ]; then
        sol_yes=yes
      else
        echo "Error: unknown option for solution: $3" >&2
        usage
      fi
    fi
    solfile="$LAB_ROOT/$2/solution.md"
    if [ ! -f "$solfile" ]; then
      echo "No solution available for lab: $2" >&2
      exit 1
    fi
    if [ "$sol_yes" = no ] && [ -t 0 ] && [ -t 1 ]; then
      read -r -p "This shows the full solution. Continue? [y/N] " sol_answer
      case "$sol_answer" in
        y|Y|yes|YES|Yes) ;;
        *) exit 0 ;;
      esac
    fi
    if command -v less >/dev/null 2>&1 && [ -t 1 ]; then
      less -R "$solfile"
    else
      cat "$solfile"
    fi
    ;;
  configure)
    case "$2" in
      interactive)
        configure_interactive
        ;;
      list)
        configure_list
        ;;
      set)
        configure_set "$3" "$4"
        ;;
      validate)
        configure_validate
        ;;
      reset)
        rm -f "$CONFIG_FILE"
        echo "Configuration reset to defaults"
        setup_default_config
        ;;
      *)
        echo "Unknown configure action: $2"
        echo "Valid actions: interactive, list, set, validate, reset"
        exit 1
        ;;
    esac
    ;;
  check)
    if [ "$#" -gt 1 ]; then
      echo "Error: check takes no arguments" >&2
      usage
    fi
    run_check
    exit $?
    ;;
  help|-h|--help)
    usage 0
    ;;
  version|-V|--version)
    case "$LABCTL_VERSION" in
      @*@) echo "labctl (development copy)" ;;
      *) echo "labctl $LABCTL_VERSION" ;;
    esac
    ;;
  *)
    usage
    ;;
esac

