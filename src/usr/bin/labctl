#!/bin/bash

LAB_ROOT="/opt/linux-labs/labs"
STATE_FILE="/opt/linux-labs/.current_lab"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/linux-labs"
CONFIG_FILE="$CONFIG_DIR/config"
SYSTEM_CONFIG="/etc/linux-labs/config"

# Use system config if available, otherwise user config
if [[ -f "$SYSTEM_CONFIG" ]]; then
    CONFIG_FILE="$SYSTEM_CONFIG"
fi

usage() {
  echo "Usage: labctl {start|task|grade|reset|list|solution|configure} <lab>"
  echo ""
  echo "Commands:"
  echo "  start <lab>              - Start a lab and show its task (requires root)"
  echo "  task <lab>               - Show the task of a lab again"
  echo "  grade <lab>              - Grade a lab"
  echo "  reset <lab>              - Reset a lab (requires root)"
  echo "  list                     - List all labs"
  echo "  solution <lab>           - Show lab solution"
  echo "  configure <action>       - Configure lab environment"
  echo ""
  echo "Configuration actions:"
  echo "  configure interactive    - Interactive configuration wizard"
  echo "  configure list           - Show current configuration"
  echo "  configure set KEY VALUE  - Set configuration value"
  echo "  configure validate       - Validate configuration"
  echo "  configure reset          - Reset to defaults"
  exit 1
}

# Require a lab name for commands that need one
require_lab() {
  local lab="$1"
  if [ -z "$lab" ]; then
    usage
  fi
  if [ ! -x "$LAB_ROOT/$lab"/setup.sh ] && [ ! -x "$LAB_ROOT/$lab"/grade.sh ] && [ ! -x "$LAB_ROOT/$lab"/cleanup.sh ]; then
    echo "Unknown lab: $lab" >&2
    exit 1
  fi
}

# Extract a one-line description for a lab from description.txt
lab_description() {
  local lab="$1"
  local desc_file="$LAB_ROOT/$lab/description.txt"
  local desc=""

  if [ -f "$desc_file" ]; then
    # Grep the objective line and extract text after "objective: "
    desc=$(grep "^objective:" "$desc_file" | sed 's/^objective:[[:space:]]*//')
  fi

  [ -z "$desc" ] && desc="No description available"
  echo "$desc"
}

# Print the value of one "key: value" line from a lab's description.txt
lab_field() {
  local lab="$1" key="$2"
  local desc_file="$LAB_ROOT/$lab/description.txt"
  [ -f "$desc_file" ] || return 0
  sed -n "s/^${key}:[[:space:]]*//p" "$desc_file" | head -n 1
}

# Print task.txt with the known placeholders filled in. Runs in a subshell
# so that load-config.sh (needed only for node placeholders) does not leak
# variables or functions into labctl.
#
# Placeholders: {{EL_MAJOR}} {{ARCH}} {{HOSTNAME}} {{LAB_USER}}
#               {{NODE_COUNT}} {{NODE1_IP}} .. {{NODE9_IP}}
render_task() (
  local lab="$1"
  local file="$LAB_ROOT/$lab/task.txt"
  local text el_major arch host lab_user n ip unknown

  text=$(cat "$file")

  # shellcheck source=/dev/null
  el_major=$(. /etc/os-release 2>/dev/null && echo "${VERSION_ID%%.*}")
  arch=$(uname -m)
  host=$(uname -n)
  # The user who runs the lab: the sudo caller, else the current non-root
  # user, else student
  if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
    lab_user="$SUDO_USER"
  elif [ "$EUID" -ne 0 ]; then
    lab_user=$(id -un)
  else
    lab_user="student"
  fi

  text=${text//"{{EL_MAJOR}}"/"$el_major"}
  text=${text//"{{ARCH}}"/"$arch"}
  text=${text//"{{HOSTNAME}}"/"$host"}
  text=${text//"{{LAB_USER}}"/"$lab_user"}

  case "$text" in
    *"{{NODE"*)
      # shellcheck source=/dev/null
      source /opt/linux-labs/lib/load-config.sh >/dev/null 2>&1
      text=${text//"{{NODE_COUNT}}"/"${NODE_COUNT:-0}"}
      for n in 1 2 3 4 5 6 7 8 9; do
        ip=""
        if [ "$n" -le "${NODE_COUNT:-0}" ]; then
          ip=$(get_node_ip "$n" 2>/dev/null)
        fi
        [ -z "$ip" ] && ip="(node $n not configured)"
        text=${text//"{{NODE${n}_IP}}"/"$ip"}
      done
      ;;
  esac

  unknown=$(printf '%s\n' "$text" | grep -o '{{[A-Za-z0-9_]*}}' | sort -u | tr '\n' ' ')
  if [ -n "$unknown" ]; then
    echo "labctl: warning: unknown placeholders in $file: $unknown" >&2
  fi

  printf '%s\n' "$text"
)

# Print the task header and the task text of a converted lab
print_task() {
  local lab="$1"
  local title category level
  title=$(lab_field "$lab" title)
  category=$(lab_field "$lab" category)
  level=$(lab_field "$lab" complexity)

  if [ -n "$title" ]; then
    printf '%s: %s\n' "$lab" "$title"
  else
    printf '%s\n' "$lab"
  fi
  printf 'Category: %s    Level: %s\n' "${category:-unknown}" "${level:-unknown}"
  printf '%s\n\n' "========================================================================"
  render_task "$lab"
}

# Setup default configuration
setup_default_config() {
  mkdir -p "$CONFIG_DIR"
  cat > "$CONFIG_FILE" << 'EOF'
# Linux Labs Configuration
LAB_NETWORK="172.25.250.0/24"
LAB_GATEWAY="172.25.250.254"
LAB_DNS="8.8.8.8"
NODES_ENABLED=false
NODE_COUNT=1
NODE_IPS=""
SSH_KEY_PATH="$HOME/.ssh/id_rsa"
SSH_USER="root"
SSH_PORT="22"
DOCKER_ENABLED=false
EOF
  echo "Created default config at $CONFIG_FILE"
}

# Load configuration
load_config() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    setup_default_config
  fi
  source "$CONFIG_FILE" 2>/dev/null || true
}

# Interactive configuration wizard
configure_interactive() {
  echo "======================================"
  echo "Linux Labs Configuration Wizard"
  echo "======================================"
  echo ""
  
  load_config
  
  echo "Current settings:"
  echo "  Lab Network: $LAB_NETWORK"
  echo "  Gateway: $LAB_GATEWAY"
  echo "  DNS: $LAB_DNS"
  echo "  Multi-node: $NODES_ENABLED"
  echo "  Node IPs: ${NODE_IPS:-auto-calculated}"
  echo ""
  
  read -p "Enable multi-node labs? (y/n) [n]: " nodes_enabled
  if [[ "$nodes_enabled" == "y" || "$nodes_enabled" == "Y" ]]; then
    NODES_ENABLED=true
    read -p "Number of nodes? [3]: " node_count
    NODE_COUNT="${node_count:-3}"
    
    echo ""
    echo "Node IP Configuration:"
    echo "  1. Auto-calculate from network (e.g., 192.168.100.11, .12, .13)"
    echo "  2. Set static IP addresses"
    read -p "Choose option [1]: " ip_option
    
    if [[ "$ip_option" == "2" ]]; then
      echo ""
      echo "Enter static IP addresses (space-separated):"
      read -p "IPs: " static_ips
      NODE_IPS="$static_ips"
      # Update NODE_COUNT based on number of IPs provided
      NODE_COUNT=$(echo "$NODE_IPS" | wc -w)
      echo "Using $NODE_COUNT static IPs: $NODE_IPS"
    else
      NODE_IPS=""
      echo "IPs will be auto-calculated from $LAB_NETWORK"
    fi
  else
    NODES_ENABLED=false
    NODE_COUNT=1
    NODE_IPS=""
  fi
  
  read -p "Lab network [${LAB_NETWORK:-172.25.250.0/24}]: " lab_network
  LAB_NETWORK="${lab_network:-${LAB_NETWORK:-172.25.250.0/24}}"
  
  read -p "Gateway IP [${LAB_GATEWAY:-172.25.250.254}]: " lab_gateway
  LAB_GATEWAY="${lab_gateway:-${LAB_GATEWAY:-172.25.250.254}}"
  
  read -p "DNS server [${LAB_DNS}]: " lab_dns
  LAB_DNS="${lab_dns:-$LAB_DNS}"
  
  # Save configuration
  mkdir -p "$CONFIG_DIR"
  cat > "$CONFIG_FILE" << EOF
# Linux Labs Configuration
LAB_NETWORK="$LAB_NETWORK"
LAB_GATEWAY="$LAB_GATEWAY"
LAB_DNS="$LAB_DNS"
NODES_ENABLED=$NODES_ENABLED
NODE_COUNT=$NODE_COUNT
NODE_IPS="$NODE_IPS"
SSH_KEY_PATH="\$HOME/.ssh/id_rsa"
SSH_USER="root"
SSH_PORT="22"
DOCKER_ENABLED=false
EOF
  
  echo ""
  echo "Configuration saved to $CONFIG_FILE"
}

# List current configuration
configure_list() {
  load_config
  echo "Current Lab Configuration:"
  echo "=========================="
  echo "Network: $LAB_NETWORK"
  echo "Gateway: $LAB_GATEWAY"
  echo "DNS: $LAB_DNS"
  echo "Multi-node enabled: $NODES_ENABLED"
  echo "Node count: $NODE_COUNT"
  if [[ -n "$NODE_IPS" ]]; then
    echo "Node IPs (static): $NODE_IPS"
  else
    echo "Node IPs: auto-calculated from network"
  fi
  echo "SSH Key: $SSH_KEY_PATH"
  echo "SSH User: $SSH_USER"
  echo "SSH Port: $SSH_PORT"
  echo "Config file: $CONFIG_FILE"
  echo ""
}

# Set specific configuration value
configure_set() {
  local key="$1"
  local value="$2"
  
  if [[ -z "$key" || -z "$value" ]]; then
    echo "Usage: labctl configure set KEY VALUE"
    exit 1
  fi
  
  load_config
  mkdir -p "$CONFIG_DIR"
  
  # Update configuration file
  if grep -q "^${key}=" "$CONFIG_FILE" 2>/dev/null; then
    sed -i "s|^${key}=.*|${key}=\"${value}\"|" "$CONFIG_FILE"
  else
    echo "${key}=\"${value}\"" >> "$CONFIG_FILE"
  fi
  
  echo "Set $key = $value"
}

# Validate configuration
configure_validate() {
  load_config
  
  echo "Validating configuration..."
  
  # Check network syntax
  if [[ ! "$LAB_NETWORK" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}/[0-9]{1,2}$ ]]; then
    echo "Error: invalid network format: $LAB_NETWORK"
    return 1
  fi
  echo "Network format valid"
  
  # Check gateway IP
  if [[ ! "$LAB_GATEWAY" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
    echo "Error: invalid gateway IP: $LAB_GATEWAY"
    return 1
  fi
  echo "Gateway IP valid"
  
  # Check DNS IP
  if [[ ! "$LAB_DNS" =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
    echo "Error: invalid DNS IP: $LAB_DNS"
    return 1
  fi
  echo "DNS IP valid"
  
  echo "All validations passed"
  return 0
}

case "$1" in
  start)
    require_lab "$2"
    if [ "$EUID" -ne 0 ]; then
      echo "Error: 'labctl start' requires root. Use: sudo labctl start $2" >&2
      exit 1
    fi
    if [ -f "$LAB_ROOT/$2/task.txt" ]; then
      # Framework 2.0 lab: setup prints nothing, labctl prints the task.
      # A failed setup leaves the lab not started.
      "$LAB_ROOT/$2/setup.sh"
      rc=$?
      if [ "$rc" -ne 0 ]; then
        echo "Error: setup of lab $2 failed (exit $rc). The lab was not started." >&2
        exit "$rc"
      fi
      mkdir -p "$(dirname "$STATE_FILE")"
      echo "$2" > "$STATE_FILE"
      print_task "$2"
    else
      # Legacy lab: setup.sh prints its own banner
      "$LAB_ROOT/$2/setup.sh"
      mkdir -p "$(dirname "$STATE_FILE")"
      echo "$2" > "$STATE_FILE"
    fi
    # The [LAB:...] prompt picks up $STATE_FILE through PROMPT_COMMAND
    # (/etc/profile.d/labctl.sh) at the next prompt of the student's shell.
    exit 0
    ;;
  task)
    require_lab "$2"
    if [ ! -f "$LAB_ROOT/$2/task.txt" ]; then
      echo "No task text for lab $2. Run 'sudo labctl start $2' to see its task." >&2
      exit 1
    fi
    print_task "$2"
    ;;
  grade)
    require_lab "$2"
    "$LAB_ROOT/$2/grade.sh"
    ;;
  reset)
    require_lab "$2"
    if [ "$EUID" -ne 0 ]; then
      echo "Error: 'labctl reset' requires root. Use: sudo labctl reset $2" >&2
      exit 1
    fi
    "$LAB_ROOT/$2/cleanup.sh"
    rc=$?
    rm -f "$STATE_FILE"
    if [ -f "$LAB_ROOT/$2/task.txt" ] && [ "$rc" -ne 0 ]; then
      # Framework 2.0 lab: report a failed cleanup
      echo "Error: cleanup of lab $2 failed (exit $rc)." >&2
      exit "$rc"
    fi
    exit 0
    ;;
  list)
    printf "%-16s  %s\n" "LAB" "DESCRIPTION"
    printf "%-16s  %s\n" "----------------" "----------------------------------------------"
    for lab in $(ls -1 "$LAB_ROOT" | sort); do
      desc=$(lab_description "$lab")
      printf "%-16s  %s\n" "$lab" "$desc"
    done
    ;;
  solution)
    require_lab "$2"
    solfile="$LAB_ROOT/$2/solution.md"
    if [ ! -f "$solfile" ]; then
      echo "No solution available for lab: $2" >&2
      exit 1
    fi
    if command -v less >/dev/null 2>&1 && [ -t 1 ]; then
      less -R "$solfile"
    else
      cat "$solfile"
    fi
    ;;
  configure)
    case "$2" in
      interactive)
        configure_interactive
        ;;
      list)
        configure_list
        ;;
      set)
        configure_set "$3" "$4"
        ;;
      validate)
        configure_validate
        ;;
      reset)
        rm -f "$CONFIG_FILE"
        echo "Configuration reset to defaults"
        setup_default_config
        ;;
      *)
        echo "Unknown configure action: $2"
        echo "Valid actions: interactive, list, set, validate, reset"
        exit 1
        ;;
    esac
    ;;
  *)
    usage
    ;;
esac

